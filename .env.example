# Docker Compose 실행: 이 파일을 루트 .env로 복사해서 사용합니다.
# 백엔드·AI 개별 실행: .env가 자동 적용되지 않으므로 IDE 또는 셸 환경 변수로 설정합니다.
# 개별 실행 시 모델 변수는 NLR_GMS_MODEL/BACKEND_GMS_MODEL 대신 GMS_MODEL을 사용합니다.
# 프론트엔드: frontend/.env.example을 frontend/.env.local로 복사합니다.

MANUAL_TEST_POSTGRES_DB=hyanghae_test
MANUAL_TEST_POSTGRES_USER=hyanghae
MANUAL_TEST_POSTGRES_PASSWORD=hyanghae_test
MANUAL_TEST_POSTGRES_PORT=5432

MANUAL_TEST_REDIS_PORT=6379
MANUAL_TEST_BACKEND_PORT=8080

GMS_API_KEY=
NLR_GMS_MODEL=gpt-5.4-nano
BACKEND_GMS_MODEL=gpt-5-nano

REVIEW_ANALYSIS_ENABLED=false

# Google 로그인(OAuth 2.0). Google Cloud 콘솔 > Google 인증 플랫폼 > 클라이언트(웹 애플리케이션)에서
# 발급합니다. GOOGLE_CLIENT_SECRET 은 비밀 값입니다. 켜려면 frontend/.env.local 에
# VITE_GOOGLE_LOGIN_ENABLED=true 도 둡니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 콘솔의 "승인된 리디렉션 URI" 와 글자 하나까지 같아야 합니다.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

IMAGE_STORAGE_S3_ENABLED=false
IMAGE_STORAGE_S3_BUCKET=hyanghae-images-prod-s15p21e203
IMAGE_STORAGE_S3_REGION=ap-northeast-2
IMAGE_STORAGE_S3_PUBLIC_BASE_URL=https://djpgc0m2v54q1.cloudfront.net
IMAGE_STORAGE_S3_KEY_PREFIX=uploads/dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

SEED_LOGIN_PASSWORD=
