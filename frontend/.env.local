# 이 파일을 복사해서 .env.local 을 만들어 사용하세요. (.env.local 은 git 에 올라가지 않습니다)
# cp .env.example .env.local

# API 요청 prefix. API 명세서의 버전 prefix 까지 포함합니다.
# '/api/v1' 로 두면 vite proxy 의 '/api' 규칙에 걸려 백엔드로 그대로 넘어갑니다.
VITE_API_BASE_URL=/api/v1

# vite dev server proxy 가 바라볼 백엔드 주소
VITE_API_PROXY_TARGET=http://localhost:8080
