FROM eclipse-temurin:21-jdk-jammy AS builder
WORKDIR /workspace
COPY . .
RUN sed -i 's/\r$//' gradlew && chmod +x gradlew && ./gradlew localSeedDist --no-daemon

FROM eclipse-temurin:21-jre-jammy
WORKDIR /workspace/backend
COPY --from=builder /workspace/build/local-seed /app
COPY --from=builder /workspace/db/seed /workspace/backend/db/seed
ENTRYPOINT ["java", "-cp", "/app/classes:/app/lib/*", "com.hyanghae.seed.DemoSeed"]
